{{!--
  Default layout.
  Contains the base HTML skeleton.
  All container pages are rendered inside {{{body}}}.
--}}

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>{{page.title}}</title>

  <!-- Project styles -->
  <link rel="stylesheet" href="/css/index.css" />

  <!-- Bootstrap CSS -->
  <link 
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" 
    rel="stylesheet"
    integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH"
    crossorigin="anonymous"
  />
</head>

<body>

  {{!-- HEADER BLOCK --}}
  {{#if header}}
    <header class="container py-4">
      <h1>{{header.name.firstname}} {{header.name.lastname}}</h1>
      <strong>{{header.position}}</strong><br />
      <em>{{header.salary}}</em><br />
      <address>{{header.address}}</address>
      <hr />
    </header>
  {{/if}}

  {{!-- Navigation partial --}}
  {{> nav}}

  {{!-- Main page content --}}
  <main class="container py-4">
    {{{body}}}
  </main>

  {{!-- Footer partial --}}
  {{> footer}}

  <!-- Bootstrap JS -->
  <script 
    src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
    integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
    crossorigin="anonymous">
  </script>

</body>
</html>
