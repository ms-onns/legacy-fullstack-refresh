<div class="container my-5">

  {{! ========================================================= }}
  {{! NAVIGATION                                                }}
  {{! ========================================================= }}
  {{#with navigation}}
    <nav class="card shadow-sm mb-5">
      <ul class="nav">
        {{#each links}}
          <li class="nav-item">
            <a
              class="nav-link {{class}}"
              href="{{href}}"
              {{#unless href}}aria-disabled="true" tabindex="-1"{{/unless}}
            >
              {{text}}
            </a>
          </li>
        {{/each}}
      </ul>
    </nav>
  {{/with}}

  {{! ========================================================= }}
  {{! MAIN GRID                                                 }}
  {{! ========================================================= }}
  <div class="row">
    {{! ================= LEFT CONTENT ================= }}
    <div class="col-8">
      {{! ================= PAGE HEADER ================= }}
      {{#with page}}
        <h1 class="mb-2">{{title}}</h1>
        <p class="text-muted">{{rating.label}}: {{rating.value}}</p>
      {{/with}}

      {{! ================= TABS ================= }}
      {{#with actions}}
        <ul class="nav nav-tabs mb-4">
          {{#each tabs}}
            <li class="nav-item">
              <a
                class="nav-link {{#if isActive}}active{{/if}}"
                href="#"
              >
                {{text}}
              </a>
            </li>
          {{/each}}
        </ul>

        {{! ================= CTA ================= }}
        {{#with reviewCta}}
          <div class="card mb-5">
            <div class="card-body d-flex justify-content-between align-items-center">
              <p class="mb-0">{{title}}</p>
              <a class="btn {{button.variant}}" href="{{button.link}}">
                {{button.text}}
              </a>
            </div>
          </div>
        {{/with}}
      {{/with}}

      {{! ================= FEEDBACK FILTER ================= }}
      {{#with feedback}}
        <h2 class="mb-3">{{title}}</h2>
        <div class="mb-5">
          {{#each buttons}}
            <a class="btn {{variant}} me-2 mb-2" href="{{link}}">
              {{text}}
            </a>
          {{/each}}
        </div>
      {{/with}}

      {{! ========================================================= }}
      {{! REVIEWS LIST                                             }}
      {{! ========================================================= }}
      {{#each reviews}}
        <div class="card mb-4">
          <div class="card-body">

            {{! ---------- REVIEW HEADER ---------- }}
            <div class="mb-3">
              <h5 class="mb-0">{{author}}</h5>
              <small class="text-muted">{{role}} • {{date}}</small>
            </div>

            {{! ---------- REVIEW META ---------- }}
            <div class="mb-3">
              <strong>{{label}}:</strong> {{seller}} <br>
              <strong>Оцінка:</strong> {{rating}}
            </div>

            {{! ---------- REVIEW TEXT ---------- }}
            {{#each content}}
              <p>{{this}}</p>
            {{/each}}

            {{! ---------- PROS / CONS ---------- }}
            <p><strong>Переваги:</strong> {{pros}}</p>
            <p><strong>Недоліки:</strong> {{cons}}</p>

            {{! ---------- IMAGES ---------- }}
            <div class="d-flex gap-2 mb-4">
              {{#each images}}
                <img src="{{this}}" class="rounded" width="80">
              {{/each}}
            </div>

            {{! ---------- COMMENTS ---------- }}
            {{#each comments}}
              <div class="card mb-2 ms-4">
                <div class="card-body p-3">
                  <strong>{{user}}</strong>
                  <small class="text-muted d-block">{{date}}</small>
                  <p class="mb-0">{{text}}</p>
                </div>
              </div>
            {{/each}}

          </div>
        </div>
      {{/each}}

    </div>

    {{! ================= RIGHT SIDEBAR ================= }}
    <div class="col-4">

      {{#with product}}
        <div class="card mb-3">
          <div class="card-body text-center">
            <img src="{{image}}" class="img-fluid mb-3">
            <h5>{{name}}</h5>
          </div>
        </div>

        <div class="card mb-3">
          <div class="card-body">
            <h4>{{price}}</h4>

            {{#if inStock}}
              <span class="badge bg-success rounded-pill mb-3">Є в наявності</span>
            {{else}}
              <span class="badge bg-danger rounded-pill mb-3">Немає в наявності</span>
            {{/if}}

            {{#each actions}}
            <div>
              <a class="btn {{variant}} mb-2" href="{{link}}">
                {{text}}
              </a>
            </div>
            {{/each}}
          </div>
        </div>

        {{#with seller}}
          <div class="card">
            <div class="card-body">
              <strong>{{label}}:</strong> {{name}}
            </div>
          </div>
        {{/with}}
      {{/with}}

    </div>
  </div>

  {{! ========================================================= }}
  {{! SERVICES                                                  }}
  {{! ========================================================= }}
  {{#with services}}
    <div class="card text-bg-success mt-5">
      <div class="card-body text-center">
        <h3>{{title}}</h3>
        <p class="mb-4">{{description}}</p>
        <a class="btn {{button.variant}}" href="{{button.link}}">
          {{button.text}}
        </a>
      </div>
    </div>
  {{/with}}

  <hr class="my-5">

  {{! ========================================================= }}
  {{! FOOTER                                                    }}
  {{! ========================================================= }}
  {{#with footer}}
    <nav>
      <ul class="nav">
        {{#each columns}}
          <li class="nav-item me-5">
            {{#each items}}
              <a class="nav-link" href="{{href}}">
                {{text}}
              </a>
            {{/each}}
          </li>
        {{/each}}
      </ul>
    </nav>
  {{/with}}

</div>
