<article>

  <header>
    <h1>{{name}}</h1>
  </header>

  <section>

    {{! ========================================================= }}
    {{!  USERS                                                   }}
    {{! ========================================================= }}
    {{#each users}}
      <article>

        <header>
          <h2>{{name}} (ID: {{id}})</h2>
        </header>

        <dl>
          <dt>Gender:</dt>
          <dd>{{gender}}</dd>

          <dt>Age:</dt>
          <dd>{{age}}</dd>
        </dl>

        {{! ===================================================== }}
        {{!  FRIENDS                                             }}
        {{! ===================================================== }}
        {{#if friends}}
          <section>
            <h3>Friends ({{friends.length}})</h3>

            <ul>
              {{#each friends}}
                <li>
                  <article>
                    <h4>{{name}} (ID: {{id}})</h4>

                    <dl>
                      <dt>Gender:</dt>
                      <dd>{{gender}}</dd>

                      <dt>Age:</dt>
                      <dd>{{age}}</dd>
                    </dl>

                    {{! ========================================= }}
                    {{!  MUTUAL FRIENDS                         }}
                    {{! ========================================= }}
                    {{#if mutual_friends}}
                      <section>
                        <h5>Mutual Friends ({{mutual_friends.length}})</h5>

                        <ul>
                          {{#each mutual_friends}}
                            <li>
                              <article>
                                <h6>{{name}} (ID: {{id}})</h6>

                                <dl>
                                  <dt>Gender:</dt>
                                  <dd>{{gender}}</dd>

                                  <dt>Age:</dt>
                                  <dd>{{age}}</dd>
                                </dl>

                                {{! =============================== }}
                                {{!  FRIENDS OF MUTUAL FRIEND     }}
                                {{! =============================== }}
                                {{#if mutual_friends}}
                                  <section>
                                    <h6>
                                      Friends of this mutual friend ({{mutual_friends.length}})
                                    </h6>

                                    <ul>
                                      {{#each mutual_friends}}
                                        <li>
                                          {{name}}
                                          (ID:
                                          {{id}},
                                          {{gender}},
                                          {{age}})
                                        </li>
                                      {{/each}}
                                    </ul>
                                  </section>
                                {{/if}}

                              </article>
                            </li>
                          {{/each}}
                        </ul>
                      </section>
                    {{/if}}

                  </article>
                </li>
              {{/each}}
            </ul>

          </section>
        {{/if}}

        {{! ===================================================== }}
        {{!  GROUPS                                              }}
        {{! ===================================================== }}
        {{#if groups}}
          <section>
            <h3>Groups ({{groups.length}})</h3>

            <ul>
              {{#each groups}}
                <li>
                  <article>
                    <h4>{{name}} (ID: {{id}})</h4>
                    <p>{{description}}</p>

                    {{#if members}}
                      <section>
                        <h5>Members ({{members.length}})</h5>

                        <ul>
                          {{#each members}}
                            <li>{{name}} (ID: {{id}}, {{gender}}, {{age}})</li>
                          {{/each}}
                        </ul>
                      </section>
                    {{/if}}

                  </article>
                </li>
              {{/each}}
            </ul>
          </section>
        {{/if}}

      </article>
    {{/each}}

  </section>
</article>