<article>

  <header>
    <h1>JavaScript — Complete Reference Guide</h1>
  </header>

  {{! ============================================= }}
  {{!  DESCRIPTION & HISTORY                        }}
  {{! ============================================= }}
  <section>
    <h2>Description</h2>
    <p>{{description}}</p>

    <dl>
      <dt><strong>History:</strong></dt>
      <dd>{{history.year}}</dd>

      <dt><strong>Founder:</strong></dt>
      <dd>{{history.founder}}</dd>
    </dl>
  </section>

  <hr />

  {{! ============================================= }}
  {{!  DATA TYPES                                   }}
  {{! ============================================= }}
  <section>
    <h2>JavaScript Data Types</h2>

    <ul>
      {{#each types}}
        <li>{{this}}</li>
      {{/each}}
    </ul>
  </section>

  <hr />

  {{! ============================================= }}
  {{!  SYNTAX                                       }}
  {{! ============================================= }}
  <section>
    {{#with syntax}}

      <h2>JavaScript Syntax Keywords</h2>

      {{! VARIABLES }}
      <article>
        <h3>Variables</h3>
        <ul>
          {{#each variables}}
            <li>{{this}}</li>
          {{/each}}
        </ul>
      </article>

      {{! FUNCTIONS }}
      <article>
        <h3>Functions</h3>
        <ul>
          {{#each functions}}
            <li>{{this}}</li>
          {{/each}}
        </ul>
      </article>

      {{! CONDITIONALS }}
      <article>
        <h3>Conditionals</h3>
        <ul>
          {{#each conditionals}}
            <li>{{this}}</li>
          {{/each}}
        </ul>
      </article>

      {{! LOOPS }}
      <article>
        <h3>Loops</h3>
        <ul>
          {{#each loops}}
            <li>{{this}}</li>
          {{/each}}
        </ul>
      </article>

      {{! CLASSES }}
      <article>
        <h3>Classes</h3>
        <ul>
          {{#each classes}}
            <li>{{this}}</li>
          {{/each}}
        </ul>
      </article>

    {{/with}}
  </section>

  <hr />

  {{! ============================================= }}
  {{!  FEATURES                                     }}
  {{! ============================================= }}
  <section>
    <h2>Core Features</h2>

    <ul>
      {{#each features}}
        <li>{{this}}</li>
      {{/each}}
    </ul>
  </section>

  <hr />

  {{! ============================================= }}
  {{!  LIBRARIES                                   }}
  {{! ============================================= }}
  <section>
    <h2>Popular Libraries</h2>

    <ul>
      {{#each libraries}}
        <li>{{this}}</li>
      {{/each}}
    </ul>
  </section>

  <hr />

  {{! ============================================= }}
  {{!  TOOLS                                       }}
  {{! ============================================= }}
  <section>
    <h2>Developer Tools</h2>

    <ul>
      {{#each tools}}
        <li>{{this}}</li>
      {{/each}}
    </ul>
  </section>

  <hr />

  {{! ============================================= }}
  {{!  COMMUNITY                                    }}
  {{! ============================================= }}
  <section>
    <h2>Community & Ecosystem</h2>

    <ul>
      {{#each community}}
        <li>
          <strong>{{name}}</strong>
          —
          <span>{{type}}</span>
        </li>
      {{/each}}
    </ul>
  </section>

</article>