{{!< default }}

<div class="container my-5">

  {{! ============================================= }}
  {{! RESUME WRAPPER                                }}
  {{! ============================================= }}
  <div class="card text-bg-secondary shadow-sm">
    <div class="card-body p-4">

      <div class="row g-4">

        {{! ============================================= }}
        {{! LEFT COLUMN: PHOTO + CONTACTS                  }}
        {{! ============================================= }}
        <aside class="col-md-3 text-center">

          {{!-- PHOTO --}}
          <div class="mt-3">
            <img
              src="{{profile.photo}}"
              alt="Profile photo"
              class="img-fluid rounded-3 mb-3 profile-photo"
            >
          </div>

          {{!-- CONTACTS CARD --}}
          <div class="card shadow-sm">
            <div class="card-body text-start">

              <h5 class="mb-3">Contacts</h5>

              <ul class="list-unstyled small mb-0">
                <li class="mb-2">
                  <span class="me-2">📧</span>
                  <a href="{{contacts.email.href}}">
                    {{contacts.email.text}}
                  </a>
                </li>

                <li class="mb-2">
                  <span class="me-2">📞</span>
                  <a href="{{contacts.phone.href}}">
                    {{contacts.phone.text}}
                  </a>
                </li>

                <li>
                  <span class="me-2">💼</span>
                  <a href="{{contacts.linkedin.href}}" target="_blank" rel="noreferrer">
                    {{contacts.linkedin.text}}
                  </a>
                </li>
              </ul>

            </div>
          </div>

        </aside>

        {{! ============================================= }}
        {{! RIGHT COLUMN: CONTENT                          }}
        {{! ============================================= }}
        <section class="col-md-9">

          {{!-- MAIN CONTENT CARD --}}
          <div class="card shadow-sm h-100">
            <div class="card-body">

              {{! ============================================= }}
              {{! HEADER                                       }}
              {{! ============================================= }}
              <header class="mb-4">
                <h1 class="mb-1">{{profile.name}}</h1>

                <p class="text-muted mb-0">
                  {{profile.position}}
                </p>

                <small class="text-muted">
                  {{profile.location}}
                </small>
              </header>

              <hr>

              {{! ============================================= }}
              {{! SUMMARY                                      }}
              {{! ============================================= }}
              <section class="mb-4">
                <h3 class="h5">Summary</h3>
                <p class="mb-0">
                  {{summary.text}}
                </p>
              </section>

              {{! ============================================= }}
              {{! SKILLS                                       }}
              {{! ============================================= }}
              <section class="mb-4">
                <h3 class="h5">Skills</h3>

                <ul class="mb-0">
                  {{#each skills}}
                    <li>{{this}}</li>
                  {{/each}}
                </ul>
              </section>

              {{! ============================================= }}
              {{! PROJECTS                                     }}
              {{! ============================================= }}
              <section>
                <h3 class="h5">Projects</h3>
                {{> playground}}
              </section>

            </div>
          </div>

        </section>

      </div>

    </div>
  </div>

</div>
