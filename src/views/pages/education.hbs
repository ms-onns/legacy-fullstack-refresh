<div>
  {{#with main}}

      <section>
				{{> title big=true data='My educations'}}
        <ul>
          {{#each educations}}
            <li>
              {{name}}
              {{#unless isEnd}} (Ще в процесі) {{/unless}}
            </li>
          {{/each}}
        </ul>
      </section>
      <section>
        {{> title big=false data='My certificates'}}
        <ul>
          {{#each certificates}}
            <li>{{name}} ({{id}})</li>
          {{/each}}
        </ul>
      </section>


  {{/with}}
</div>